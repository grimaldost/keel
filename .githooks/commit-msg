#!/bin/sh
# keel's commit-msg hook — the same tracked-hooksPath pattern as .githooks/pre-commit
# (that file records why `pre-commit install` is not the instruction). Runs the commit-msg
# stage: a Conventional Commit subject, and no AI-attribution trailer anywhere in the message.
HERE=$(dirname "$0")
exec uv run python -m pre_commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=commit-msg \
	--hook-dir "$HERE" \
	-- "$@"
